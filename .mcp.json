{
  "mcpServers": {
    "chrome-devtools-mcp": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://192.168.1.150:9222"
      ],
      "command": "npx"
    },
    "kr0ki-mcp": {
      "args": [
        "--context",
        "Default",
        "-n",
        "kr0ki",
        "exec",
        "-i",
        "pod/kr0ki-local",
        "-c",
        "kr0ki-mcp",
        "--",
        "python3",
        "/opt/kr0ki-mcp/bridge.py"
      ],
      "command": "kubectl"
    }
  }
}