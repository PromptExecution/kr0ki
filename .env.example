# Machine-local deployment settings. Copy to `.env`, replace the placeholders,
# and use `just pod-up`. The file stays local; `just pod-env` turns it into the
# `kr0ki-local-env` Kubernetes Secret without printing its values.

# The OpenAI-compatible LLM endpoint used by the StoryB00k sidecar.
OPENAI_API_KEY=replace-with-local-key
OPENAI_API_URL=http://192.168.1.137:8001/v1

# Browser origins allowed to call the StoryB00k sidecar on port 8789.
KR0KI_STORYB00K_ALLOWED_ORIGINS=http://localhost:8787,http://192.168.1.137:8787

# Optional read-only SysML v2 API. Leave both unset when no model server exists.
# KR0KI_SYSMLV2_BASE_URL=https://sysml.example.invalid
# KR0KI_SYSMLV2_TOKEN=replace-with-model-server-token
