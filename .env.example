# Machine-local deployment settings. Copy to `.env`, replace the placeholders,
# and use `just pod-up`. The file stays local; `just pod-env` turns it into the
# `kr0ki-local-env` Kubernetes Secret without printing its values.

# The OpenAI-compatible LLM endpoint used by the StoryB00k sidecar.
OPENAI_API_KEY=replace-with-local-key
OPENAI_API_URL=http://llm-host.example.invalid:8001/v1

# Where this machine's kr0ki server and StoryB00k agent are reached from a browser and
# from the functional tests / Vite dev proxy (`just`, tests/functional, playbook).
# Defaults to loopback when unset; set these for a LAN or remote deployment.
KR0KI_PUBLIC_URL=http://kr0ki-host.example.invalid:8787
KR0KI_AGENT_PUBLIC_URL=http://kr0ki-host.example.invalid:8789

# Browser origins allowed to call the StoryB00k sidecar on port 8789. `just agent` adds
# loopback and KR0KI_PUBLIC_URL automatically; list extra origins here.
KR0KI_STORYB00K_ALLOWED_ORIGINS=http://localhost:8787,http://kr0ki-host.example.invalid:8787

# Optional read-only SysML v2 API. Leave both unset when no model server exists.
# KR0KI_SYSMLV2_BASE_URL=https://sysml.example.invalid
# KR0KI_SYSMLV2_TOKEN=replace-with-model-server-token

# Optional Ledgrrr state-machine contract registry.  kr0ki does not persist or
# interpret those contracts; this is a service-discovery setting for future
# consumers that need to resolve a named contract.
# B00T_STATE_REGISTRY_URL=http://ledgrrr.example.invalid
