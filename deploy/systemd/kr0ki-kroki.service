[Unit]
Description=kr0ki: private Kroki-compatible render backend (:8010)
After=network-online.target

[Service]
ExecStartPre=-/usr/bin/podman rm -f kr0ki-dev-kroki
ExecStart=/usr/bin/podman run --rm --name kr0ki-dev-kroki --memory=2g --memory-swap=2g --cpus=1 -p 8010:8000 -e KROKI_SAFE_MODE=secure localhost/kr0ki-kroki-compat:dev
ExecStop=/usr/bin/podman stop -t 10 kr0ki-dev-kroki
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
